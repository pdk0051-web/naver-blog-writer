{
  "name": "naver-blog-writer",
  "productName": "네이버 블로그 글쓰기 도우미",
  "version": "0.1.0",
  "description": "AI로 네이버 블로그 초안을 만들어 편집기에 넣고 임시저장까지 해 주는 데스크톱 앱. 발행은 사람이 직접 합니다.",
  "author": "pdk0051-web",
  "license": "MIT",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "test:smoke": "electron test/smoke/smoke-main.mjs",
    "screenshots": "electron test/smoke/smoke-main.mjs --screenshots",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.pdk0051web.naverblogwriter",
    "productName": "Naver Blog Writer",
    "artifactName": "naver-blog-writer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleDisplayName": "네이버 블로그 글쓰기 도우미"
      }
    },
    "dmg": {
      "title": "글쓰기 도우미 ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "naver-blog-writer"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "네이버 블로그 글쓰기 도우미",
      "uninstallDisplayName": "네이버 블로그 글쓰기 도우미"
    }
  }
}
